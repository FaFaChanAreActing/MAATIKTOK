{
    "interface_version": 2,
    "name": "MAATIKTOK",
    "description": "抖音自动打开火花好友流程",
    "controller": [
        {
            "name": "安卓模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "抖音资源",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "从打开抖音开始",
            "entry": "打开抖音"
        },
        {
            "name": "从主页面开始",
            "entry": "打开好友界面"
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    }
}