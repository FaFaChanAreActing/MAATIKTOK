{
    "打开抖音": {
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.ss.android.ugc.aweme"
            }
        },
        "post_delay": 10000,
        "next": [
            "初始化状态"
        ]
    },
    "初始化状态": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "init_state"
            }
        },
        "next": [
            "处理弹窗",
            "打开好友界面"
        ]
    },
    "处理弹窗": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "handle_popup"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 2000,
        "next": [
            "处理弹窗",
            "打开好友界面"
        ]
    },
    "打开好友界面": {
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    768,
                    677
                ]
            }
        },
        "post_delay": 5000,
        "next": [
            "上滑列表到好友列"
        ]
    },
    "上滑列表到好友列": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    500,
                    600
                ],
                "end": [
                    500,
                    325
                ],
                "duration": 500
            }
        },
        "post_delay": 5000,
        "next": [
            "浏览屏"
        ]
    },
    "浏览屏": {
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "匹配未记录火花好友",
            "处理无匹配"
        ]
    },
    "匹配未记录火花好友": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "match_unsent_spark"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 4000,
        "next": [
            "聊天页分派"
        ]
    },
    "聊天页分派": {
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "校验好友",
            "未知页返回"
        ]
    },
    "校验好友": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "verify_chat_title"
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "识别今日是否发送",
            "发送续火文案"
        ]
    },
    "未知页返回": {
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "返回消息列表"
        ]
    },
    "识别今日是否发送": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "check_sent_today"
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "标记已处理"
        ]
    },
    "标记已处理": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "mark_processed"
            }
        },
        "next": [
            "返回消息列表"
        ]
    },
    "发送续火文案": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "send_greeting"
            }
        },
        "next": [
            "返回消息列表"
        ]
    },
    "返回消息列表": {
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "back_to_list"
            }
        },
        "next": [
            "浏览屏"
        ]
    },
    "处理无匹配": {
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "检查到底部",
            "上滑到下一屏"
        ]
    },
    "检查到底部": {
        "recognition": {
            "type": "Custom",
            "param": {
                "custom_recognition": "check_bottom"
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "全部打开完毕"
        ]
    },
    "上滑到下一屏": {
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    500,
                    600
                ],
                "end": [
                    500,
                    350
                ],
                "duration": 500
            }
        },
        "post_delay": 5000,
        "next": [
            "浏览屏"
        ]
    },
    "全部打开完毕": {
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.ss.android.ugc.aweme"
            }
        }
    },
